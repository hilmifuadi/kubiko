---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Toast from '../components/Toast.astro';
import { siteConfig } from '../data/services';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = `${siteConfig.siteName} — ${siteConfig.tagline}`, 
  description = siteConfig.description 
} = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth" style="color-scheme: light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://kubiko.my.id" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/favicon.svg" />

    <!-- Theme Color matching Warm Light Background -->
    <meta name="theme-color" content="#FAF7F0" />

    <!-- Preconnect Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>

  <body class="min-w-[320px] bg-warm-bg text-warm-charcoal antialiased selection:bg-warm-accent selection:text-warm-bg pt-[env(safe-area-inset-top)] pb-[env(safe-area-inset-bottom)] pl-[env(safe-area-inset-left)] pr-[env(safe-area-inset-right)]">
    <!-- Accessible Skip Link for Keyboard Navigation -->
    <a 
      href="#main-content" 
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2.5 focus:bg-warm-accent focus:text-warm-bg focus:font-bold focus:rounded-xl focus:shadow-card focus:outline-none focus:ring-2 focus:ring-warm-accent focus:ring-offset-2 focus:ring-offset-warm-bg transition-transform"
    >
      Loncat ke konten utama
    </a>

    <Navbar />

    <main id="main-content" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>

    <Footer />
    <Toast />

    <!-- Client-side Interactive Logic (Vanilla JS for zero runtime overhead) -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        initCategoryFilter();
        initClickToCopy();
        initSmartUptimeKuma();
      });

      // 1. Instant Category Filter with URL Sync & Keyboard Support
      function initCategoryFilter() {
        const filterButtons = Array.from(document.querySelectorAll('.filter-tab'));
        const cards = Array.from(document.querySelectorAll('.service-card'));
        if (filterButtons.length === 0) return;

        function applyFilter(category, updateUrl = true) {
          // Update active button state and accessibility attributes
          filterButtons.forEach(btn => {
            const isMatch = btn.getAttribute('data-filter') === category;
            btn.setAttribute('aria-selected', isMatch ? 'true' : 'false');
            btn.setAttribute('tabindex', isMatch ? '0' : '-1');

            if (isMatch) {
              btn.classList.add('bg-[#161513]', 'text-[#FAF7F0]', 'shadow-brutal-sm');
              btn.classList.remove('bg-[#FAF7F0]', 'text-[#161513]');
              const countEl = btn.querySelector('.tab-count');
              if (countEl) {
                countEl.className = 'tab-count text-[11px] font-mono tabular-nums px-2 py-0.5 rounded-full border border-[#161513] font-bold bg-[#EAA838] text-[#161513]';
              }
            } else {
              btn.classList.remove('bg-[#161513]', 'text-[#FAF7F0]', 'shadow-brutal-sm');
              btn.classList.add('bg-[#FAF7F0]', 'text-[#161513]');
              const countEl = btn.querySelector('.tab-count');
              if (countEl) {
                countEl.className = 'tab-count text-[11px] font-mono tabular-nums px-2 py-0.5 rounded-full border border-[#161513] font-bold bg-[#F2ECE1] text-[#161513]';
              }
            }
          });

          // Show or hide corresponding cards
          cards.forEach(card => {
            const cardCat = card.getAttribute('data-category');
            if (category === 'all' || cardCat === category) {
              card.style.display = 'flex';
              card.classList.remove('opacity-0', 'scale-95');
              card.classList.add('opacity-100', 'scale-100');
            } else {
              card.style.display = 'none';
            }
          });

          // Sync URL search params
          if (updateUrl && window.history && window.history.replaceState) {
            const url = new URL(window.location.href);
            if (category === 'all') {
              url.searchParams.delete('category');
            } else {
              url.searchParams.set('category', category);
            }
            window.history.replaceState({}, '', url.toString());
          }
        }

        // Attach Click & Keyboard Event Handlers
        filterButtons.forEach((btn, index) => {
          btn.addEventListener('click', () => {
            const category = btn.getAttribute('data-filter') || 'all';
            applyFilter(category, true);
          });

          // Arrow Key Navigation between tabs
          btn.addEventListener('keydown', (e) => {
            let targetIndex = null;
            if (e.key === 'ArrowRight') {
              targetIndex = (index + 1) % filterButtons.length;
            } else if (e.key === 'ArrowLeft') {
              targetIndex = (index - 1 + filterButtons.length) % filterButtons.length;
            } else if (e.key === 'Home') {
              targetIndex = 0;
            } else if (e.key === 'End') {
              targetIndex = filterButtons.length - 1;
            }

            if (targetIndex !== null) {
              e.preventDefault();
              filterButtons[targetIndex].focus();
              const category = filterButtons[targetIndex].getAttribute('data-filter') || 'all';
              applyFilter(category, true);
            }
          });
        });

        // Initialize state from URL param if present
        const initialUrl = new URL(window.location.href);
        const requestedCat = initialUrl.searchParams.get('category');
        const validCategories = ['all', 'media', 'utility', 'game'];
        if (requestedCat && validCategories.includes(requestedCat)) {
          applyFilter(requestedCat, false);
        }
      }

      // 2. Click to Copy with Visual & Toast Feedback
      function initClickToCopy() {
        const copyButtons = document.querySelectorAll('.copy-btn');

        copyButtons.forEach(btn => {
          btn.addEventListener('click', async () => {
            const textToCopy = btn.getAttribute('data-copy-text');
            const serviceName = btn.getAttribute('data-service-name') || 'Server';
            if (!textToCopy) return;

            try {
              if (navigator.clipboard && navigator.clipboard.writeText) {
                await navigator.clipboard.writeText(textToCopy);
              } else {
                const textarea = document.createElement('textarea');
                textarea.value = textToCopy;
                textarea.style.position = 'fixed';
                textarea.style.opacity = '0';
                document.body.appendChild(textarea);
                textarea.select();
                document.execCommand('copy');
                document.body.removeChild(textarea);
              }

              // Update Button State
              const labelEl = btn.querySelector('.copy-label');
              const origText = labelEl ? labelEl.textContent : '';
              if (labelEl) labelEl.textContent = 'Tersalin!';
              btn.classList.add('bg-[#EAA838]', 'text-[#161513]');

              if (window.showToast) {
                window.showToast(`Alamat ${serviceName} (${textToCopy}) berhasil disalin!`);
              }

              setTimeout(() => {
                if (labelEl) labelEl.textContent = origText;
                btn.classList.remove('bg-[#EAA838]', 'text-[#161513]');
              }, 2000);
            } catch (err) {
              console.error('Failed to copy text: ', err);
            }
          });
        });
      }

      // 3. Smart Uptime Kuma Status Monitor (with Keyword Auto-Matching & SLA metrics)
      async function initSmartUptimeKuma() {
        const refreshBtn = document.getElementById('refresh-status-btn');
        const refreshIcon = refreshBtn ? refreshBtn.querySelector('.refresh-icon') : null;

        async function fetchStatus() {
          if (refreshIcon) refreshIcon.classList.add('animate-spin');

          const candidateSlugs = ['family', 'kubiko', 'default'];
          let hbData = null;
          let pageData = null;

          // Attempt each candidate slug
          for (const slug of candidateSlugs) {
            try {
              const [hbRes, pageRes] = await Promise.all([
                fetch(`/api/status-page/heartbeat/${slug}`, { cache: 'no-store' }),
                fetch(`/api/status-page/${slug}`, { cache: 'no-store' }).catch(() => null)
              ]);

              if (hbRes.ok) {
                const json = await hbRes.json();
                if (json && json.heartbeatList && Object.keys(json.heartbeatList).length > 0) {
                  hbData = json;
                  if (pageRes && pageRes.ok) {
                    pageData = await pageRes.json().catch(() => null);
                  }
                  break;
                }
              }
            } catch (e) {
              // Try next slug
            }
          }

          // Fallback to local mock data if external API unreachable
          if (!hbData) {
            try {
              const fallbackRes = await fetch('/mock-status.json');
              if (fallbackRes.ok) {
                hbData = await fallbackRes.json();
              }
            } catch (fallbackErr) {
              console.warn('Fallback status unavailable:', fallbackErr);
            }
          }

          if (refreshIcon) {
            setTimeout(() => refreshIcon.classList.remove('animate-spin'), 600);
          }

          if (!hbData || !hbData.heartbeatList) return;

          // Extract remote monitors list for smart name/keyword matching
          const remoteMonitors = [];
          if (pageData && pageData.publicGroupList) {
            for (const group of pageData.publicGroupList) {
              if (group.monitorList) {
                for (const m of group.monitorList) {
                  remoteMonitors.push(m);
                }
              }
            }
          }

          const hbList = hbData.heartbeatList;
          const upList = hbData.uptimeList || {};

          let totalMonitored = 0;
          let onlineCount = 0;
          let offlineCount = 0;
          let pingTotal = 0;
          let pingCount = 0;
          let uptimeTotal = 0;
          let uptimeCount = 0;

          const serviceCards = document.querySelectorAll('.service-card');

          serviceCards.forEach(card => {
            const rawMonitorId = card.getAttribute('data-monitor-id');
            const keywordsRaw = card.getAttribute('data-keywords') || '[]';
            let keywords = [];
            try { keywords = JSON.parse(keywordsRaw); } catch(e) {}

            let resolvedId = null;

            // 1. Try smart matching by keyword
            if (remoteMonitors.length > 0 && keywords.length > 0) {
              const matched = remoteMonitors.find(rm => {
                const nameLower = (rm.name || '').toLowerCase();
                return keywords.some(kw => nameLower.includes(kw.toLowerCase()));
              });
              if (matched) resolvedId = String(matched.id);
            }

            // 2. Fallback to assigned numeric monitor ID
            if (!resolvedId && rawMonitorId && hbList[rawMonitorId]) {
              resolvedId = String(rawMonitorId);
            }

            const entries = resolvedId ? hbList[resolvedId] : null;
            if (!entries || entries.length === 0) return;

            totalMonitored++;
            const latest = entries[entries.length - 1];
            const isUp = latest.status === 1;

            if (isUp) {
              onlineCount++;
            } else if (latest.status === 0) {
              offlineCount++;
            }

            // Update Card Status Indicator
            const dotEl = card.querySelector('.status-dot');
            const ringEl = card.querySelector('.status-pulse-ring');
            const labelEl = card.querySelector('.status-label');
            const metricsEl = card.querySelector('.service-metrics');
            const pingEl = card.querySelector('.service-ping');
            const uptimeEl = card.querySelector('.service-uptime');

            if (dotEl && ringEl && labelEl) {
              if (isUp) {
                dotEl.className = 'status-dot relative inline-flex rounded-full h-2 w-2 bg-status-online';
                ringEl.className = 'status-pulse-ring animate-ping absolute inline-flex h-full w-full rounded-full bg-status-online opacity-75';
                labelEl.textContent = 'Siap Digunakan';
                labelEl.classList.remove('text-status-offline');
              } else {
                dotEl.className = 'status-dot relative inline-flex rounded-full h-2 w-2 bg-status-offline';
                ringEl.className = 'status-pulse-ring animate-ping absolute inline-flex h-full w-full rounded-full bg-status-offline opacity-75';
                labelEl.textContent = 'Sedang Gangguan';
                labelEl.classList.add('text-status-offline');
              }
            }

            // Record ping metrics
            if (latest.ping !== null && latest.ping !== undefined) {
              const pingNum = Math.round(latest.ping);
              pingTotal += pingNum;
              pingCount++;
            }

            const rawUptime = resolvedId ? upList[`${resolvedId}_24`] : null;
            if (typeof rawUptime === 'number') {
              const upPercent = (rawUptime * 100).toFixed(1);
              uptimeTotal += parseFloat(upPercent);
              uptimeCount++;
            }
          });

          // Update Global Badge on Navbar
          const globalBadge = document.getElementById('global-status-badge');
          if (globalBadge) {
            const textEl = globalBadge.querySelector('.status-text');
            const dotEl = globalBadge.querySelector('.status-dot');
            const pingEl = globalBadge.querySelector('.status-ping');

            if (offlineCount > 0) {
              if (textEl) textEl.textContent = `${offlineCount} Layanan Terkendala`;
              if (dotEl) dotEl.className = 'status-dot relative inline-flex rounded-full h-2 w-2 bg-status-offline';
              if (pingEl) pingEl.className = 'status-ping animate-ping absolute inline-flex h-full w-full rounded-full bg-status-offline opacity-75';
            } else {
              if (textEl) textEl.textContent = 'Semua Layanan Siap';
              if (dotEl) dotEl.className = 'status-dot relative inline-flex rounded-full h-2 w-2 bg-status-online';
              if (pingEl) pingEl.className = 'status-ping animate-ping absolute inline-flex h-full w-full rounded-full bg-status-online opacity-75';
            }
          }

          // Update Hero Telemetry Card
          const heroPing = document.getElementById('hero-ping-val');
          if (heroPing && pingCount > 0) {
            heroPing.textContent = `Lancar (~${Math.round(pingTotal / pingCount)} ms)`;
          }

          const heroActive = document.getElementById('hero-active-val');
          if (heroActive) {
            heroActive.textContent = offlineCount > 0 ? `${offlineCount} Gangguan` : 'Semua Normal';
          }

          const heroHomeStatus = document.getElementById('hero-home-status');
          if (heroHomeStatus) {
            heroHomeStatus.textContent = offlineCount > 0 ? 'Sebagian Offline' : 'Normal';
          }

          const heroLastChecked = document.getElementById('hero-last-checked');
          if (heroLastChecked) {
            const timeFormatter = new Intl.DateTimeFormat('id-ID', {
              hour: '2-digit',
              minute: '2-digit',
              second: '2-digit',
              hour12: false
            });
            const timeStr = timeFormatter.format(new Date());
            heroLastChecked.innerHTML = `Terakhir dicek pukul <span class="font-mono tabular-nums font-medium">${timeStr}</span> WIB · Tiap 60&nbsp;dtk`;
          }
        }

        // Run initial fetch
        fetchStatus();

        // Refresh on button click
        if (refreshBtn) {
          refreshBtn.addEventListener('click', () => {
            fetchStatus();
          });
        }

        // Auto poll every 60 seconds
        setInterval(fetchStatus, 60000);
      }
    </script>
  </body>
</html>
