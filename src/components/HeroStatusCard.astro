---
import { siteConfig } from '../data/services';
import { Server, ShieldCheck, Cpu, RefreshCw, Zap } from 'lucide-astro';
---

<div class="relative rounded-2xl bg-warm-sand border border-warm-border p-5 sm:p-6 shadow-card hover:border-warm-border-hover transition-all">
  <!-- Window Header with 3 Decorative Dots ala Cloudzy / Mac window + Refresh button -->
  <div class="flex items-center justify-between pb-4 border-b border-warm-border/80">
    <div class="flex items-center gap-2">
      <span class="w-3 h-3 rounded-full bg-[#E57373] border border-[#D32F2F]/20"></span>
      <span class="w-3 h-3 rounded-full bg-[#FFB74D] border border-[#F57C00]/20"></span>
      <span class="w-3 h-3 rounded-full bg-[#81C784] border border-[#388E3C]/20"></span>
      <span class="ml-2 font-mono text-xs font-semibold text-warm-muted tracking-tight">edge-gateway // tailscale-mesh</span>
    </div>
    
    <button 
      id="refresh-status-btn"
      type="button" 
      class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-warm-surface/80 border border-warm-border hover:border-warm-border-hover text-[11px] font-mono text-warm-charcoal hover:text-warm-accent transition-all cursor-pointer shadow-subtle active:scale-95"
      title="Segarkan status Uptime Kuma"
    >
      <RefreshCw class="w-3 h-3 refresh-icon transition-transform" />
      <span class="hidden sm:inline">Segarkan</span>
    </button>
  </div>

  <!-- Telemetry Nodes List -->
  <div class="mt-4 space-y-3 font-mono text-xs">
    
    <!-- Node 1: Edge VPS -->
    <div class="p-3 rounded-xl bg-warm-surface border border-warm-border hover:border-warm-border-hover transition-colors flex items-start justify-between gap-3">
      <div class="flex items-start gap-3">
        <div class="mt-0.5 p-1.5 rounded-lg bg-warm-sand text-warm-charcoal">
          <Server class="w-4 h-4 text-warm-accent" />
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="font-bold text-warm-charcoal">Edge Node</span>
            <span class="px-1.5 py-0.2 rounded text-[10px] bg-emerald-50 text-emerald-700 border border-emerald-200">
              VPS Singapore
            </span>
          </div>
          <p class="text-warm-muted text-[11px] mt-0.5">Caddy Web Server • Auto SSL Let's Encrypt</p>
        </div>
      </div>
      <div class="text-right whitespace-nowrap">
        <span class="inline-flex items-center gap-1 text-[11px] text-emerald-600 font-medium">
          <span class="w-1.5 h-1.5 rounded-full bg-status-online"></span>
          Online
        </span>
        <div class="text-[10px] text-warm-muted">1 vCPU / 1GB</div>
      </div>
    </div>

    <!-- Node 2: Tailscale Mesh Tunnel -->
    <div class="p-3 rounded-xl bg-warm-surface border border-warm-border hover:border-warm-border-hover transition-colors flex items-start justify-between gap-3">
      <div class="flex items-start gap-3">
        <div class="mt-0.5 p-1.5 rounded-lg bg-warm-sand text-warm-charcoal">
          <ShieldCheck class="w-4 h-4 text-warm-accent" />
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="font-bold text-warm-charcoal">Tunneling</span>
            <span class="px-1.5 py-0.2 rounded text-[10px] bg-blue-50 text-blue-700 border border-blue-200">
              Tailscale Mesh
            </span>
          </div>
          <p class="text-warm-muted text-[11px] mt-0.5">WireGuard encrypted • Tembus CGNAT Rumah</p>
        </div>
      </div>
      <div class="text-right whitespace-nowrap">
        <span class="inline-flex items-center gap-1 text-[11px] text-emerald-600 font-medium">
          <span class="w-1.5 h-1.5 rounded-full bg-status-online"></span>
          Active
        </span>
        <div class="text-[10px] text-warm-muted">Zero Port Forward</div>
      </div>
    </div>

    <!-- Node 3: Home Server Node -->
    <div class="p-3 rounded-xl bg-warm-surface border border-warm-border hover:border-warm-border-hover transition-colors flex items-start justify-between gap-3">
      <div class="flex items-start gap-3">
        <div class="mt-0.5 p-1.5 rounded-lg bg-warm-sand text-warm-charcoal">
          <Cpu class="w-4 h-4 text-warm-accent" />
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="font-bold text-warm-charcoal">Home Server</span>
            <span class="px-1.5 py-0.2 rounded text-[10px] bg-amber-50 text-amber-700 border border-amber-200">
              Local Machine
            </span>
          </div>
          <p class="text-warm-muted text-[11px] mt-0.5">Jellyfin · Nextcloud · PDF · Crafty</p>
        </div>
      </div>
      <div class="text-right whitespace-nowrap">
        <span class="inline-flex items-center gap-1 text-[11px] text-emerald-600 font-medium">
          <span class="w-1.5 h-1.5 rounded-full bg-status-online"></span>
          <span id="hero-home-status">Connected</span>
        </span>
        <div class="text-[10px] text-warm-muted">LAN Service Core</div>
      </div>
    </div>

  </div>

  <!-- Telemetry Metrics Bar & Last Checked -->
  <div class="mt-4 pt-4 border-t border-warm-border/80 grid grid-cols-3 gap-2 text-center font-mono">
    <div class="p-2 rounded-lg bg-warm-surface/60 border border-warm-border/60">
      <div class="text-[10px] text-warm-muted uppercase">Ping (Home)</div>
      <div class="text-xs font-bold text-warm-charcoal mt-0.5 flex items-center justify-center gap-1">
        <Zap class="w-3 h-3 text-amber-500" />
        <span id="hero-ping-val">~18 ms</span>
      </div>
    </div>
    <div class="p-2 rounded-lg bg-warm-surface/60 border border-warm-border/60">
      <div class="text-[10px] text-warm-muted uppercase">Kuma SLA</div>
      <div class="text-xs font-bold text-warm-charcoal mt-0.5 text-warm-accent" id="hero-sla-val">99.9%</div>
    </div>
    <div class="p-2 rounded-lg bg-warm-surface/60 border border-warm-border/60">
      <div class="text-[10px] text-warm-muted uppercase">Layanan Aktif</div>
      <div class="text-xs font-bold text-warm-charcoal mt-0.5 text-warm-charcoal" id="hero-active-val">Semua</div>
    </div>
  </div>

  <!-- Timestamp footnote -->
  <div class="mt-3 text-right text-[10px] font-mono text-warm-muted" id="hero-last-checked">
    Sinkronisasi otomatis setiap 60s
  </div>
</div>
