---
import { Film, HardDrive, FileText, Gamepad2, RefreshCw, Zap } from 'lucide-astro';
---

<div class="relative">
  <!-- Decorative Dot Matrix Pattern Behind (Matching reference graphic element) -->
  <div class="absolute -top-4 -right-4 w-28 h-28 dot-matrix-pattern opacity-30 pointer-events-none hidden sm:block" aria-hidden="true"></div>

  <!-- Main Editorial Hero Card Container -->
  <div class="relative rounded-3xl bg-[#FAF7F0] border-2 border-[#161513] p-5 sm:p-7 shadow-brutal-lg transition-[border-color,box-shadow]">
    
    <!-- Top Header: Window Controls + Refresh Action -->
    <div class="flex items-center justify-between pb-4 border-b-2 border-[#161513]">
      <div class="flex items-center gap-2">
        <span class="w-3.5 h-3.5 rounded-full bg-[#DE5D35] border border-[#161513]" aria-hidden="true"></span>
        <span class="w-3.5 h-3.5 rounded-full bg-[#EAA838] border border-[#161513]" aria-hidden="true"></span>
        <span class="w-3.5 h-3.5 rounded-full bg-status-online border border-[#161513]" aria-hidden="true"></span>
        <span class="ml-2 font-mono text-[11px] font-bold uppercase tracking-wider text-[#161513]">
          TELEMETRI SISTEM
        </span>
      </div>
      
      <button 
        id="refresh-status-btn"
        type="button" 
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#F2ECE1] border-2 border-[#161513] hover:bg-[#EAA838] text-[11px] font-bold text-[#161513] transition-[background-color,transform] cursor-pointer shadow-brutal-sm active:translate-x-0.5 active:translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#161513]"
        aria-label="Segarkan status layanan sekarang"
        title="Periksa ulang kondisi layanan"
      >
        <RefreshCw class="w-3 h-3 refresh-icon transition-transform" aria-hidden="true" />
        <span class="font-mono uppercase text-[10px] tracking-wider">Segarkan</span>
      </button>
    </div>

    <!-- Service Status List (Editorial Card Rows) -->
    <div class="mt-4 space-y-2.5">
      
      <!-- Service 1: Film & Video -->
      <div class="p-3 rounded-2xl bg-white border-2 border-[#161513] flex items-center justify-between gap-3 shadow-brutal-sm hover:-translate-y-0.5 transition-transform">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-[#FAF7F0] border border-[#161513] flex items-center justify-center text-[#DE5D35]">
            <Film class="w-4 h-4" aria-hidden="true" />
          </div>
          <div>
            <div class="font-bold text-xs sm:text-sm text-[#161513]">Nonton Film & Video</div>
            <p class="text-[#6B655D] text-[11px]">Streaming tanpa jeda iklan</p>
          </div>
        </div>
        <div class="text-right whitespace-nowrap">
          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase bg-emerald-50 text-emerald-800 border border-emerald-600/30">
            <span class="w-1.5 h-1.5 rounded-full bg-status-online" aria-hidden="true"></span>
            Online
          </span>
        </div>
      </div>

      <!-- Service 2: Berkas & Dokumen -->
      <div class="p-3 rounded-2xl bg-white border-2 border-[#161513] flex items-center justify-between gap-3 shadow-brutal-sm hover:-translate-y-0.5 transition-transform">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-[#FAF7F0] border border-[#161513] flex items-center justify-center text-[#EAA838]">
            <HardDrive class="w-4 h-4" aria-hidden="true" />
          </div>
          <div>
            <div class="font-bold text-xs sm:text-sm text-[#161513]">Penyimpanan Berkas</div>
            <p class="text-[#6B655D] text-[11px]">Foto liburan & dokumen</p>
          </div>
        </div>
        <div class="text-right whitespace-nowrap">
          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase bg-emerald-50 text-emerald-800 border border-emerald-600/30">
            <span class="w-1.5 h-1.5 rounded-full bg-status-online" aria-hidden="true"></span>
            Online
          </span>
        </div>
      </div>

      <!-- Service 3: Dokumen PDF -->
      <div class="p-3 rounded-2xl bg-white border-2 border-[#161513] flex items-center justify-between gap-3 shadow-brutal-sm hover:-translate-y-0.5 transition-transform">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-[#FAF7F0] border border-[#161513] flex items-center justify-center text-[#161513]">
            <FileText class="w-4 h-4" aria-hidden="true" />
          </div>
          <div>
            <div class="font-bold text-xs sm:text-sm text-[#161513]">Pengolah Dokumen PDF</div>
            <p class="text-[#6B655D] text-[11px]">Gabung & perkecil berkas</p>
          </div>
        </div>
        <div class="text-right whitespace-nowrap">
          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase bg-emerald-50 text-emerald-800 border border-emerald-600/30">
            <span class="w-1.5 h-1.5 rounded-full bg-status-online" aria-hidden="true"></span>
            Online
          </span>
        </div>
      </div>

      <!-- Service 4: Game & Hiburan -->
      <div class="p-3 rounded-2xl bg-white border-2 border-[#161513] flex items-center justify-between gap-3 shadow-brutal-sm hover:-translate-y-0.5 transition-transform">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-[#FAF7F0] border border-[#161513] flex items-center justify-center text-[#DE5D35]">
            <Gamepad2 class="w-4 h-4" aria-hidden="true" />
          </div>
          <div>
            <div class="font-bold text-xs sm:text-sm text-[#161513]">Server Minecraft</div>
            <p class="text-[#6B655D] text-[11px]">Dunia survival keluarga</p>
          </div>
        </div>
        <div class="text-right whitespace-nowrap">
          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase bg-emerald-50 text-emerald-800 border border-emerald-600/30">
            <span class="w-1.5 h-1.5 rounded-full bg-status-online" aria-hidden="true"></span>
            <span id="hero-home-status">Online</span>
          </span>
        </div>
      </div>

    </div>

    <!-- Telemetry Metrics Bar (Editorial 3-Col Box) -->
    <div class="mt-4 pt-4 border-t-2 border-[#161513] grid grid-cols-3 gap-2 text-center">
      <div class="p-2.5 rounded-xl bg-[#F2ECE1] border border-[#161513]">
        <div class="text-[9px] font-mono font-bold uppercase text-[#6B655D]">Koneksi</div>
        <div class="text-xs font-bold text-[#161513] mt-0.5 flex items-center justify-center gap-1">
          <Zap class="w-3 h-3 text-[#EAA838]" aria-hidden="true" />
          <span id="hero-ping-val" class="font-mono tabular-nums">Lancar</span>
        </div>
      </div>
      <div class="p-2.5 rounded-xl bg-[#F2ECE1] border border-[#161513]">
        <div class="text-[9px] font-mono font-bold uppercase text-[#6B655D]">Kondisi</div>
        <div class="text-xs font-bold text-emerald-800 mt-0.5 tabular-nums" id="hero-active-val">Semua Normal</div>
      </div>
      <div class="p-2.5 rounded-xl bg-[#F2ECE1] border border-[#161513]">
        <div class="text-[9px] font-mono font-bold uppercase text-[#6B655D]">Jaminan</div>
        <div class="text-xs font-bold text-[#DE5D35] mt-0.5">Bebas Iklan</div>
      </div>
    </div>

    <!-- Status Summary footnote -->
    <div class="mt-3 text-right font-mono text-[10px] text-[#6B655D]" id="hero-last-checked">
      Pengecekan otomatis berkala
    </div>

  </div>
</div>
