---
import { siteConfig } from '../data/services';
import { Server, ShieldCheck, Cpu, RefreshCw, Zap, CheckCircle2 } from 'lucide-astro';
---

<div class="relative rounded-2xl bg-warm-sand border border-warm-border p-5 sm:p-6 shadow-card hover:border-warm-border-hover transition-all">
  <!-- Window Header with 3 Decorative Dots + Refresh button -->
  <div class="flex items-center justify-between pb-4 border-b border-warm-border/80">
    <div class="flex items-center gap-2">
      <span class="w-3 h-3 rounded-full bg-[#E57373] border border-[#D32F2F]/20"></span>
      <span class="w-3 h-3 rounded-full bg-[#FFB74D] border border-[#F57C00]/20"></span>
      <span class="w-3 h-3 rounded-full bg-[#81C784] border border-[#388E3C]/20"></span>
      <span class="ml-2 text-xs font-semibold text-warm-charcoal tracking-tight">Kondisi Server Rumah</span>
    </div>
    
    <button 
      id="refresh-status-btn"
      type="button" 
      class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-warm-surface/80 border border-warm-border hover:border-warm-border-hover text-[11px] font-medium text-warm-charcoal hover:text-warm-accent transition-all cursor-pointer shadow-subtle active:scale-95"
      title="Periksa ulang kondisi server"
    >
      <RefreshCw class="w-3 h-3 refresh-icon transition-transform" />
      <span>Segarkan</span>
    </button>
  </div>

  <!-- Telemetry Nodes List (Sederhana & Mudah Dipahami) -->
  <div class="mt-4 space-y-3 text-xs">
    
    <!-- Node 1: Edge VPS -->
    <div class="p-3 rounded-xl bg-warm-surface border border-warm-border flex items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="p-1.5 rounded-lg bg-warm-sand text-warm-charcoal">
          <Server class="w-4 h-4 text-warm-accent" />
        </div>
        <div>
          <div class="font-bold text-warm-charcoal">Gerbang Web</div>
          <p class="text-warm-muted text-[11px]">Koneksi Aman HTTPS (Cloud VPS)</p>
        </div>
      </div>
      <div class="text-right whitespace-nowrap">
        <span class="inline-flex items-center gap-1 text-[11px] text-emerald-600 font-medium">
          <span class="w-1.5 h-1.5 rounded-full bg-status-online"></span>
          Aktif
        </span>
      </div>
    </div>

    <!-- Node 2: Tailscale Mesh Tunnel -->
    <div class="p-3 rounded-xl bg-warm-surface border border-warm-border flex items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="p-1.5 rounded-lg bg-warm-sand text-warm-charcoal">
          <ShieldCheck class="w-4 h-4 text-warm-accent" />
        </div>
        <div>
          <div class="font-bold text-warm-charcoal">Jalur Privat</div>
          <p class="text-warm-muted text-[11px]">Koneksi Langsung ke Server Rumah</p>
        </div>
      </div>
      <div class="text-right whitespace-nowrap">
        <span class="inline-flex items-center gap-1 text-[11px] text-emerald-600 font-medium">
          <span class="w-1.5 h-1.5 rounded-full bg-status-online"></span>
          Terhubung
        </span>
      </div>
    </div>

    <!-- Node 3: Home Server Node -->
    <div class="p-3 rounded-xl bg-warm-surface border border-warm-border flex items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="p-1.5 rounded-lg bg-warm-sand text-warm-charcoal">
          <Cpu class="w-4 h-4 text-warm-accent" />
        </div>
        <div>
          <div class="font-bold text-warm-charcoal">Server Rumah</div>
          <p class="text-warm-muted text-[11px]">Penyimpan Film, File & Game</p>
        </div>
      </div>
      <div class="text-right whitespace-nowrap">
        <span class="inline-flex items-center gap-1 text-[11px] text-emerald-600 font-medium">
          <span class="w-1.5 h-1.5 rounded-full bg-status-online"></span>
          <span id="hero-home-status">Normal</span>
        </span>
      </div>
    </div>

  </div>

  <!-- Telemetry Metrics Bar (Ramah Keluarga) -->
  <div class="mt-4 pt-4 border-t border-warm-border/80 grid grid-cols-3 gap-2 text-center">
    <div class="p-2 rounded-lg bg-warm-surface/60 border border-warm-border/60">
      <div class="text-[10px] text-warm-muted uppercase">Kecepatan</div>
      <div class="text-xs font-bold text-warm-charcoal mt-0.5 flex items-center justify-center gap-1">
        <Zap class="w-3 h-3 text-amber-500" />
        <span id="hero-ping-val">Cepat</span>
      </div>
    </div>
    <div class="p-2 rounded-lg bg-warm-surface/60 border border-warm-border/60">
      <div class="text-[10px] text-warm-muted uppercase">Kondisi</div>
      <div class="text-xs font-bold text-emerald-700 mt-0.5" id="hero-active-val">Semua Normal</div>
    </div>
    <div class="p-2 rounded-lg bg-warm-surface/60 border border-warm-border/60">
      <div class="text-[10px] text-warm-muted uppercase">Akses</div>
      <div class="text-xs font-bold text-warm-accent mt-0.5">Bebas Iklan</div>
    </div>
  </div>

  <!-- Status Summary footnote -->
  <div class="mt-3 text-right text-[10px] text-warm-muted" id="hero-last-checked">
    Layanan diperiksa otomatis setiap saat
  </div>
</div>
