---
import type { ServiceItem } from '../types/service';

interface Props {
  services: ServiceItem[];
}

const { services } = Astro.props;

const counts = {
  all: services.length,
  media: services.filter(s => s.category === 'media').length,
  utility: services.filter(s => s.category === 'utility').length,
  game: services.filter(s => s.category === 'game').length,
};

const filterTabs = [
  { id: 'all', label: 'Semua Layanan', count: counts.all },
  { id: 'media', label: 'Film & Video', count: counts.media },
  { id: 'utility', label: 'File & Dokumen', count: counts.utility },
  { id: 'game', label: 'Game Santai', count: counts.game },
];
---

<div 
  class="flex items-center gap-2.5 overflow-x-auto pb-2 scrollbar-none" 
  id="category-filter-tabs"
  role="tablist"
  aria-label="Filter kategori layanan keluarga"
>
  {filterTabs.map((tab, idx) => (
    <button
      type="button"
      id={`tab-${tab.id}`}
      role="tab"
      aria-selected={idx === 0 ? 'true' : 'false'}
      tabindex={idx === 0 ? 0 : -1}
      aria-controls="services-grid"
      data-filter={tab.id}
      class={`filter-tab min-h-[44px] px-4 sm:px-5 py-2.5 rounded-full text-xs font-bold uppercase tracking-wider transition-[background-color,border-color,color,box-shadow,transform] whitespace-nowrap flex items-center gap-2 cursor-pointer border-2 border-[#161513] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#161513] focus-visible:ring-offset-2 ${
        idx === 0 
          ? 'bg-[#161513] text-[#FAF7F0] shadow-brutal-sm' 
          : 'bg-[#FAF7F0] text-[#161513] hover:bg-[#F2ECE1]'
      }`}
    >
      <span>{tab.label}</span>
      <span class={`tab-count text-[11px] font-mono tabular-nums px-2 py-0.5 rounded-full border border-[#161513] font-bold ${
        idx === 0 ? 'bg-[#EAA838] text-[#161513]' : 'bg-[#F2ECE1] text-[#161513]'
      }`}>
        {tab.count}
      </span>
    </button>
  ))}
</div>
