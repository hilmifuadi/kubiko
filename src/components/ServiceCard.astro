---
import { Film, FileText, Gamepad2, Dices, HardDrive, Activity, Copy, ArrowUpRight, Sparkles, Ticket } from 'lucide-astro';
import type { ServiceItem } from '../types/service';

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;

// Accent color mapping per service category
const categoryAccent = {
  media: 'bg-[#DE5D35] text-[#FAF7F0]',
  utility: 'bg-[#EAA838] text-[#161513]',
  game: 'bg-[#161513] text-[#FAF7F0]',
}[service.category] || 'bg-[#161513] text-[#FAF7F0]';
---

<div 
  class="service-card group relative flex flex-col justify-between rounded-3xl bg-white border-2 border-[#161513] shadow-brutal hover:shadow-brutal-lg hover:-translate-x-0.5 hover:-translate-y-0.5 transition-[box-shadow,transform] duration-200 overflow-hidden"
  data-category={service.category}
  data-service-id={service.id}
  data-monitor-id={service.uptimeKumaMonitorId}
  data-keywords={service.uptimeKumaKeywords ? JSON.stringify(service.uptimeKumaKeywords) : '[]'}
>
  <div>
    <!-- Top Editorial Header Strip -->
    <div class="px-6 sm:px-8 pt-6 sm:pt-7 pb-4 bg-[#FAF7F0] border-b-2 border-[#161513] flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <!-- Big Icon Badge -->
        <div class="w-12 h-12 rounded-2xl bg-white border-2 border-[#161513] flex items-center justify-center text-[#161513] shadow-brutal-sm group-hover:rotate-6 transition-transform">
          {service.icon === 'Film' && <Film class="w-6 h-6 text-[#DE5D35]" aria-hidden="true" />}
          {service.icon === 'Ticket' && <Ticket class="w-6 h-6 text-[#DE5D35]" aria-hidden="true" />}
          {service.icon === 'FileText' && <FileText class="w-6 h-6 text-[#161513]" aria-hidden="true" />}
          {service.icon === 'Gamepad2' && <Gamepad2 class="w-6 h-6 text-[#DE5D35]" aria-hidden="true" />}
          {service.icon === 'Dices' && <Dices class="w-6 h-6 text-[#EAA838]" aria-hidden="true" />}
          {service.icon === 'HardDrive' && <HardDrive class="w-6 h-6 text-[#EAA838]" aria-hidden="true" />}
          {!['Film', 'Ticket', 'FileText', 'Gamepad2', 'Dices', 'HardDrive'].includes(service.icon) && <Activity class="w-6 h-6" aria-hidden="true" />}
        </div>

        <div>
          <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase tracking-wider border border-[#161513] bg-[#F2ECE1] text-[#161513]">
            {service.tag}
          </span>
          <div class="text-[11px] font-mono text-[#6B655D] mt-0.5 truncate max-w-[180px] sm:max-w-none" translate="no">
            {service.subdomain}
          </div>
        </div>
      </div>

      <!-- Live Status Pill -->
      <div 
        class="service-status-pill inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-mono font-bold uppercase tracking-wider bg-white border border-[#161513] text-[#161513] shadow-brutal-sm"
      >
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="status-pulse-ring animate-ping absolute inline-flex h-full w-full rounded-full bg-status-online opacity-75"></span>
          <span class="status-dot relative inline-flex rounded-full h-2 w-2 bg-status-online"></span>
        </span>
        <span class="status-label">{service.isUpcoming ? 'Segera' : 'Aktif'}</span>
      </div>
    </div>

    <!-- Body Content -->
    <div class="p-6 sm:p-8">
      <div class="flex items-center gap-2">
        <h3 class="font-serif font-black text-2xl sm:text-3xl tracking-tight text-[#161513] text-balance group-hover:text-[#DE5D35] transition-colors">
          {service.name}
        </h3>
        {service.featured && (
          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase bg-[#EAA838] text-[#161513] border border-[#161513]">
            <Sparkles class="w-3 h-3" aria-hidden="true" />
            Favorit
          </span>
        )}
      </div>

      <!-- Description -->
      <p class="mt-3 text-sm text-[#6B655D] leading-relaxed text-pretty">
        {service.description}
      </p>

      <!-- Specs / Keunggulan Layanan -->
      {service.specs && service.specs.length > 0 && (
        <div class="mt-5 pt-4 border-t border-[#E2D9CC] flex flex-wrap items-center gap-2">
          {service.specs.map((spec) => (
            <span class="px-2.5 py-1 rounded-lg bg-[#FAF7F0] border border-[#161513] text-[#161513] font-mono text-[11px] font-medium">
              <span class="text-[#DE5D35] mr-1" aria-hidden="true">✓</span>{spec}
            </span>
          ))}
        </div>
      )}
    </div>
  </div>

  <!-- Bottom Action Footer -->
  <div class="px-6 sm:px-8 py-4 bg-[#FAF7F0] border-t-2 border-[#161513] flex items-center justify-between gap-3">
    {service.copyText ? (
      <div class="flex items-center gap-3 w-full">
        <button 
          type="button"
          class="copy-btn min-h-[44px] flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-full text-xs font-bold uppercase tracking-wider bg-white text-[#161513] border-2 border-[#161513] hover:bg-[#EAA838] active:translate-x-0.5 active:translate-y-0.5 transition-[background-color,transform] cursor-pointer shadow-brutal-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#161513]"
          data-copy-text={service.copyText}
          data-service-name={service.name}
          aria-label={`Salin alamat server ${service.name}`}
          title={`Salin alamat ${service.copyText}`}
        >
          <span class="copy-icon" aria-hidden="true">
            <Copy class="w-3.5 h-3.5" />
          </span>
          <span class="copy-label">Salin Alamat</span>
        </button>

        <a 
          href={service.url}
          target="_blank"
          rel="noopener noreferrer"
          class="min-w-[44px] min-h-[44px] flex items-center justify-center p-2.5 rounded-full bg-[#161513] text-[#FAF7F0] hover:bg-[#DE5D35] transition-[background-color,transform] border-2 border-[#161513] shadow-brutal-sm hover:scale-105 active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#161513]"
          title={`Buka ${service.name} di tab baru`}
          aria-label={`Buka ${service.name} di tab baru`}
        >
          <ArrowUpRight class="w-5 h-5 stroke-[2.5]" aria-hidden="true" />
        </a>
      </div>
    ) : (
      <div class="flex items-center justify-between w-full">
        <span class="font-mono text-[11px] font-bold uppercase text-[#6B655D]">
          100% Bebas Iklan
        </span>

        <a 
          href={service.url}
          target="_blank"
          rel="noopener noreferrer"
          class="min-h-[44px] inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs font-bold uppercase tracking-wider bg-[#161513] text-[#FAF7F0] hover:bg-[#DE5D35] transition-[background-color,transform] border-2 border-[#161513] shadow-brutal-sm hover:-translate-x-0.5 hover:-translate-y-0.5 active:translate-x-0 active:translate-y-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#161513]"
          title={`Buka ${service.name} di tab baru`}
        >
          <span>{service.isUpcoming ? 'Lihat Info' : 'Buka Layanan'}</span>
          <ArrowUpRight class="w-4 h-4 stroke-[2.5]" aria-hidden="true" />
        </a>
      </div>
    )}
  </div>
</div>
