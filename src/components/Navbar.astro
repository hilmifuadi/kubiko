---
import { siteConfig } from '../data/services';
import { ArrowUpRight } from 'lucide-astro';
---

<header class="sticky top-0 z-40 w-full bg-[#FAF7F0]/95 backdrop-blur-md border-b-2 border-[#161513] transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-18 sm:h-20">
      
      <!-- Brand & Sunburst Emblem -->
      <div class="flex items-center gap-3 sm:gap-6">
        <a 
          href="/" 
          class="flex items-center gap-2.5 group rounded-xl p-1 -m-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#161513] focus-visible:ring-offset-2 focus-visible:ring-offset-[#FAF7F0]"
          aria-label="Kubiko Portal Beranda"
        >
          <!-- Sunburst Icon (Matching Reference Graphic) -->
          <span class="w-8 h-8 rounded-full bg-[#DE5D35] text-[#FAF7F0] flex items-center justify-center font-black group-hover:rotate-45 transition-transform duration-300 shadow-brutal-sm">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2l2.4 4.8 5.3-2.1-2.1 5.3 4.8 2.4-4.8 2.4 2.1 5.3-5.3-2.1-2.4 4.8-2.4-4.8-5.3 2.1 2.1-5.3-4.8-2.4 4.8-2.4-2.1-5.3 5.3 2.1z"/>
            </svg>
          </span>

          <span class="font-serif font-black text-2xl sm:text-3xl tracking-tight text-[#161513] flex items-center" translate="no">
            KUBIKO
          </span>
          <span class="hidden lg:inline-block ml-1 px-2 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase tracking-wider bg-[#EAA838] border border-[#161513] text-[#161513]">
            PORTAL
          </span>
        </a>

        <!-- Global Status Pill (Editorial Badge) -->
        <a 
          href={siteConfig.statusPageUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="hidden md:inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-[#FAF7F0] border-2 border-[#161513] hover:bg-[#F2ECE1] transition-colors text-[#161513] shadow-brutal-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#161513] focus-visible:ring-offset-2"
          id="global-status-badge"
          title="Lihat status sistem real-time (buka di tab baru)"
        >
          <span class="relative flex h-2.5 w-2.5" aria-hidden="true">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-status-online opacity-75 status-ping"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-status-online status-dot"></span>
          </span>
          <span class="status-text font-mono text-[11px] tracking-tight uppercase">Sistem Normal</span>
        </a>
      </div>

      <!-- Navigation Links (Editorial Minimalist Sans) -->
      <nav class="hidden md:flex items-center gap-1 sm:gap-4 lg:gap-6" aria-label="Navigasi Utama">
        <a 
          href="/#services" 
          class="px-2 py-1 text-xs font-bold uppercase tracking-widest text-[#161513] hover:text-[#DE5D35] transition-colors relative after:absolute after:bottom-0 after:left-0 after:w-0 hover:after:w-full after:h-0.5 after:bg-[#DE5D35] after:transition-[width] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#161513]"
        >
          Layanan
        </a>
        <a 
          href="/#fitur" 
          class="px-2 py-1 text-xs font-bold uppercase tracking-widest text-[#161513] hover:text-[#DE5D35] transition-colors relative after:absolute after:bottom-0 after:left-0 after:w-0 hover:after:w-full after:h-0.5 after:bg-[#DE5D35] after:transition-[width] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#161513]"
        >
          Fitur
        </a>
        <a 
          href="/#panduan" 
          class="px-2 py-1 text-xs font-bold uppercase tracking-widest text-[#161513] hover:text-[#DE5D35] transition-colors relative after:absolute after:bottom-0 after:left-0 after:w-0 hover:after:w-full after:h-0.5 after:bg-[#DE5D35] after:transition-[width] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#161513]"
        >
          Panduan
        </a>
        <a 
          href="/#subdomain-routes" 
          class="px-2 py-1 text-xs font-bold uppercase tracking-widest text-[#161513] hover:text-[#DE5D35] transition-colors relative after:absolute after:bottom-0 after:left-0 after:w-0 hover:after:w-full after:h-0.5 after:bg-[#DE5D35] after:transition-[width] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#161513]"
        >
          Alamat Web
        </a>
        <a 
          href="#tentang" 
          class="px-2 py-1 text-xs font-bold uppercase tracking-widest text-[#161513] hover:text-[#DE5D35] transition-colors relative after:absolute after:bottom-0 after:left-0 after:w-0 hover:after:w-full after:h-0.5 after:bg-[#DE5D35] after:transition-[width] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#161513]"
        >
          Tentang
        </a>
      </nav>

      <!-- Right Action Pill Button (Matching "LET'S WORK TOGETHER ->") -->
      <div class="flex items-center gap-3">
        <a
          href={siteConfig.statusPageUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs font-bold uppercase tracking-wider bg-[#EAA838] text-[#161513] border-2 border-[#161513] hover:bg-[#D99625] transition-[background-color,transform] shadow-brutal-sm hover:shadow-brutal hover:-translate-x-0.5 hover:-translate-y-0.5 active:translate-x-0 active:translate-y-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#161513] focus-visible:ring-offset-2"
          title="Periksa halaman status monitor (tab baru)"
        >
          <span>Status Sistem</span>
          <ArrowUpRight class="w-3.5 h-3.5 stroke-[2.5]" aria-hidden="true" />
        </a>

        <!-- Mobile Menu Button -->
        <button 
          id="mobile-menu-btn"
          type="button" 
          class="md:hidden min-w-[44px] min-h-[44px] p-2.5 rounded-xl bg-[#FAF7F0] border-2 border-[#161513] text-[#161513] hover:bg-[#EAA838] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#161513] focus-visible:ring-offset-2 transition-colors cursor-pointer flex items-center justify-center shadow-brutal-sm"
          aria-label="Buka menu navigasi"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="w-6 h-6 stroke-[2.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-t-2 border-[#161513] bg-[#FAF7F0] px-4 pt-3 pb-5 space-y-2">
    <div class="py-2 mb-1">
      <a 
        href={siteConfig.statusPageUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center justify-between px-4 py-3 rounded-xl text-xs font-bold uppercase tracking-wider bg-[#F2ECE1] border-2 border-[#161513] text-[#161513] shadow-brutal-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#161513]"
      >
        <span class="flex items-center gap-2">
          <span class="relative flex h-2.5 w-2.5" aria-hidden="true">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-status-online opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-status-online"></span>
          </span>
          <span>Status Layanan: Normal</span>
        </span>
        <ArrowUpRight class="w-4 h-4 text-[#161513]" aria-hidden="true" />
      </a>
    </div>
    <a href="/#services" class="block px-4 py-2.5 rounded-xl text-sm font-bold uppercase tracking-wider text-[#161513] hover:bg-[#EAA838] transition-colors border border-transparent hover:border-[#161513]">Layanan Keluarga</a>
    <a href="/#fitur" class="block px-4 py-2.5 rounded-xl text-sm font-bold uppercase tracking-wider text-[#161513] hover:bg-[#EAA838] transition-colors border border-transparent hover:border-[#161513]">Fitur Utama</a>
    <a href="/#panduan" class="block px-4 py-2.5 rounded-xl text-sm font-bold uppercase tracking-wider text-[#161513] hover:bg-[#EAA838] transition-colors border border-transparent hover:border-[#161513]">Panduan Akses</a>
    <a href="/#subdomain-routes" class="block px-4 py-2.5 rounded-xl text-sm font-bold uppercase tracking-wider text-[#161513] hover:bg-[#EAA838] transition-colors border border-transparent hover:border-[#161513]">Alamat Web</a>
    <a href="#tentang" class="block px-4 py-2.5 rounded-xl text-sm font-bold uppercase tracking-wider text-[#161513] hover:bg-[#EAA838] transition-colors border border-transparent hover:border-[#161513]">Tentang</a>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  function toggleMenu() {
    if (!mobileMenu || !menuBtn) return;
    const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
    menuBtn.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
    mobileMenu.classList.toggle('hidden');
  }

  menuBtn?.addEventListener('click', toggleMenu);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menuBtn?.getAttribute('aria-expanded') === 'true') {
      menuBtn.setAttribute('aria-expanded', 'false');
      mobileMenu?.classList.add('hidden');
      menuBtn.focus();
    }
  });

  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menuBtn?.setAttribute('aria-expanded', 'false');
      mobileMenu?.classList.add('hidden');
    });
  });
</script>
