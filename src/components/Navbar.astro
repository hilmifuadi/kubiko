---
import { siteConfig } from '../data/services';
import { Activity, ArrowUpRight } from 'lucide-astro';
---

<header class="sticky top-0 z-40 w-full backdrop-blur-md bg-warm-bg/90 border-b border-warm-border transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      
      <!-- Brand & Global Status -->
      <div class="flex items-center gap-4 sm:gap-6">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-xl bg-warm-accent flex items-center justify-center text-warm-bg font-bold shadow-subtle group-hover:scale-105 transition-transform">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m21.12 6.4-6.05-4.06a2 2 0 0 0-2.17-.05L2.95 8.41a2 2 0 0 0-.95 1.7v7.82a2 2 0 0 0 .98 1.72l9.93 6.06a2 2 0 0 0 2.06 0l6.15-3.76a2 2 0 0 0 .88-1.7V8.12a2 2 0 0 0-.88-1.72Z"/>
              <path d="m12 22 9-5.5V11L12 16.5 3 11v5.5l9 5.5Z"/>
              <path d="m12 16.5V2"/>
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="font-extrabold text-lg sm:text-xl tracking-tight text-warm-charcoal flex items-center gap-1.5">
              kubiko<span class="text-warm-accent">.my.id</span>
            </span>
            <span class="text-[11px] text-warm-muted hidden sm:inline-block">Portal Layanan Keluarga</span>
          </div>
        </a>

        <!-- Global Status Pill -->
        <a 
          href={siteConfig.statusPageUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="hidden md:inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-warm-sand border border-warm-border hover:border-warm-border-hover transition-colors text-warm-charcoal"
          id="global-status-badge"
          title="Lihat kondisi sistem"
        >
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-status-online opacity-75 status-ping"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-status-online status-dot"></span>
          </span>
          <span class="status-text">Semua Layanan Normal</span>
          <ArrowUpRight class="w-3 h-3 text-warm-muted" />
        </a>
      </div>

      <!-- Navigation Links -->
      <nav class="hidden md:flex items-center gap-1 sm:gap-2">
        <a 
          href="#services" 
          class="px-3 py-2 rounded-lg text-sm font-medium text-warm-charcoal hover:bg-warm-sand hover:text-warm-accent transition-colors"
        >
          Layanan
        </a>
        <a 
          href="#panduan" 
          class="px-3 py-2 rounded-lg text-sm font-medium text-warm-charcoal hover:bg-warm-sand hover:text-warm-accent transition-colors"
        >
          Panduan
        </a>
        <a 
          href="#subdomain-routes" 
          class="px-3 py-2 rounded-lg text-sm font-medium text-warm-charcoal hover:bg-warm-sand hover:text-warm-accent transition-colors"
        >
          Alamat Web
        </a>
        <a 
          href="#topology" 
          class="px-3 py-2 rounded-lg text-sm font-medium text-warm-charcoal hover:bg-warm-sand hover:text-warm-accent transition-colors"
        >
          Arsitektur Jaringan
        </a>
      </nav>

      <!-- Right Action / Mobile Toggle -->
      <div class="flex items-center gap-2">
        <a
          href={siteConfig.statusPageUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold bg-warm-sand text-warm-charcoal border border-warm-border hover:bg-warm-surface hover:border-warm-border-hover transition-all shadow-subtle"
        >
          <Activity class="w-4 h-4 text-warm-accent" />
          <span class="hidden sm:inline">Cek Status</span>
        </a>

        <!-- Mobile Menu Button -->
        <button 
          id="mobile-menu-btn"
          type="button" 
          class="md:hidden p-2 rounded-lg text-warm-charcoal hover:bg-warm-sand focus:outline-none cursor-pointer"
          aria-label="Buka menu"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-warm-border bg-warm-bg px-4 pt-2 pb-4 space-y-1">
    <div class="py-2 mb-2">
      <a 
        href={siteConfig.statusPageUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center justify-between px-3 py-2 rounded-lg text-xs font-medium bg-warm-sand border border-warm-border text-warm-charcoal"
      >
        <span class="flex items-center gap-2">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-status-online opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-status-online"></span>
          </span>
          <span>Status Layanan: Normal</span>
        </span>
        <ArrowUpRight class="w-3.5 h-3.5 text-warm-muted" />
      </a>
    </div>
    <a href="#services" class="block px-3 py-2 rounded-lg text-sm font-medium text-warm-charcoal hover:bg-warm-sand">Layanan Keluarga</a>
    <a href="#panduan" class="block px-3 py-2 rounded-lg text-sm font-medium text-warm-charcoal hover:bg-warm-sand">Panduan Akses</a>
    <a href="#subdomain-routes" class="block px-3 py-2 rounded-lg text-sm font-medium text-warm-charcoal hover:bg-warm-sand">Alamat Web</a>
    <a href="#topology" class="block px-3 py-2 rounded-lg text-sm font-medium text-warm-charcoal hover:bg-warm-sand">Arsitektur Jaringan</a>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
    });
  });
</script>
