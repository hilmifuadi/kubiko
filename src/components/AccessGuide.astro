---
import { caddyProxyChain } from '../data/services';
import { Copy, ArrowUpRight, ShieldCheck, Heart } from 'lucide-astro';

const accessSteps = [
  {
    step: '01',
    title: 'Pilih Layanan',
    detail: 'Klik layanan yang ingin Anda pakai di atas (film, penyimpanan file, dokumen, atau game).'
  },
  {
    step: '02',
    title: 'Masuk dengan Akun Pribadi',
    detail: 'Gunakan akun yang telah didaftarkan untuk menonton film pribadi atau mengakses file Anda.'
  },
  {
    step: '03',
    title: 'Nikmati Sepuasnya',
    detail: 'Seluruh layanan ini gratis dan bebas dari iklan komersial untuk kenyamanan keluarga.'
  }
];
---

<section id="panduan" class="py-12 sm:py-16 border-t border-warm-border scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Kolom Kiri: 3 Langkah Sederhana -->
      <div class="lg:col-span-5 space-y-5">
        <div>
          <div class="inline-flex items-center gap-1.5 text-xs uppercase tracking-wider text-warm-muted mb-1.5 font-medium">
            <span class="w-2 h-2 rounded-sm bg-warm-accent"></span>
            <span>Panduan Mudah</span>
          </div>
          <h2 class="text-2xl font-bold text-warm-charcoal tracking-tight">
            Cara Menggunakan Layanan
          </h2>
          <p class="text-sm text-warm-muted mt-1 leading-relaxed">
            Tidak perlu pengaturan rumit, cukup buka lewat browser di HP, laptop, atau smart TV Anda.
          </p>
        </div>

        <div class="divide-y divide-warm-border border-y border-warm-border">
          {accessSteps.map((item) => (
            <div class="py-3.5 flex items-start gap-3.5">
              <span class="font-bold text-xs text-warm-accent pt-0.5 shrink-0">
                {item.step}.
              </span>
              <div>
                <h3 class="text-sm font-semibold text-warm-charcoal">{item.title}</h3>
                <p class="mt-0.5 text-xs text-warm-muted leading-relaxed">{item.detail}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="p-3.5 rounded-xl bg-warm-sand/80 border border-warm-border text-xs text-warm-muted flex items-center gap-3">
          <Heart class="w-4 h-4 text-warm-terracotta shrink-0" />
          <span>Disediakan khusus untuk kemudahan dan hiburan seluruh keluarga.</span>
        </div>
      </div>

      <!-- Kolom Kanan: Daftar Alamat Web Ramah Pengguna -->
      <div id="subdomain-routes" class="lg:col-span-7 bg-warm-surface rounded-2xl border border-warm-border shadow-card overflow-hidden">
        
        <div class="px-5 py-3.5 bg-warm-sand/60 border-b border-warm-border flex items-center justify-between gap-4">
          <div>
            <h3 class="font-bold text-sm text-warm-charcoal font-sans">
              Daftar Alamat Web
            </h3>
            <p class="text-xs text-warm-muted">Bisa disimpan di bookmark browser Anda</p>
          </div>
        </div>

        <div class="divide-y divide-warm-border/60 text-xs">
          {caddyProxyChain.map((route) => {
            const fullUrl = `https://${route.from}`;
            return (
              <div class="p-4 flex items-center justify-between gap-4 hover:bg-warm-sand/30 transition-colors">
                <div class="min-w-0">
                  <div class="font-medium text-warm-charcoal text-sm truncate">
                    {route.target}
                  </div>
                  <div class="text-xs text-warm-muted font-mono mt-0.5 truncate">
                    {route.from}
                  </div>
                </div>

                <div class="flex items-center gap-2 shrink-0">
                  <button
                    type="button"
                    class="copy-btn px-2.5 py-1.5 rounded-lg border border-warm-border hover:bg-warm-sand text-warm-charcoal transition-colors cursor-pointer text-xs font-medium inline-flex items-center gap-1.5"
                    data-copy-text={route.from}
                    data-service-name={route.target}
                    title={`Salin ${route.from}`}
                  >
                    <Copy class="w-3.5 h-3.5 text-warm-muted" />
                    <span class="copy-label hidden sm:inline">Salin</span>
                  </button>
                  <a
                    href={fullUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-3 py-1.5 rounded-lg bg-warm-charcoal hover:bg-warm-accent text-warm-bg transition-colors inline-flex items-center gap-1 text-xs font-medium"
                    title={`Buka ${fullUrl}`}
                  >
                    <span>Buka</span>
                    <ArrowUpRight class="w-3.5 h-3.5" />
                  </a>
                </div>
              </div>
            );
          })}
        </div>

      </div>

    </div>

  </div>
</section>
