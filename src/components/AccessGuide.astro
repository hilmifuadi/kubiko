---
import { caddyProxyChain } from '../data/services';
import { Copy, ArrowUpRight, Heart, Sparkles } from 'lucide-astro';

const accessSteps = [
  {
    step: '01',
    title: 'Pilih Layanan',
    detail: 'Klik salah satu layanan yang ingin Anda gunakan (film, cloud file, dokumen, atau game).'
  },
  {
    step: '02',
    title: 'Masuk dengan Akun Pribadi',
    detail: 'Gunakan akun yang telah didaftarkan untuk menonton film atau mengakses berkas pribadi Anda.'
  },
  {
    step: '03',
    title: 'Nikmati Sepuasnya',
    detail: 'Seluruh utilitas ini 100% gratis dan bebas dari iklan komersial untuk kenyamanan seluruh keluarga.'
  }
];
---

<section id="panduan" class="py-16 sm:py-24 border-t-2 border-[#161513] bg-[#FAF7F0] scroll-mt-20 sm:scroll-mt-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Kolom Kiri: 3 Langkah Sederhana -->
      <div class="lg:col-span-5 space-y-6">
        <div>
          <span class="inline-block px-3 py-1 rounded-full text-xs font-mono font-bold uppercase tracking-wider bg-[#DE5D35] text-[#FAF7F0] border border-[#161513] shadow-brutal-sm mb-3">
            PANDUAN MUDAH
          </span>
          <h2 class="font-serif font-black text-3xl sm:text-4xl text-[#161513] tracking-tight text-balance">
            Cara Menggunakan Layanan.
          </h2>
          <p class="text-sm text-[#6B655D] mt-2 leading-relaxed text-pretty">
            Tidak memerlukan instalasi yang rumit. Cukup akses melalui peramban web di HP, tablet, laptop, atau Smart TV keluarga.
          </p>
        </div>

        <div class="divide-y-2 divide-[#161513] border-y-2 border-[#161513]">
          {accessSteps.map((item) => (
            <div class="py-4 flex items-start gap-4">
              <span class="w-8 h-8 rounded-full bg-[#EAA838] border-2 border-[#161513] text-[#161513] font-mono font-black text-xs flex items-center justify-center shrink-0 shadow-brutal-sm">
                {item.step}
              </span>
              <div>
                <h3 class="font-bold text-sm text-[#161513] uppercase tracking-wide">{item.title}</h3>
                <p class="mt-1 text-xs text-[#6B655D] leading-relaxed">{item.detail}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="p-4 rounded-2xl bg-[#F2ECE1] border-2 border-[#161513] text-xs text-[#161513] flex items-center gap-3 shadow-brutal-sm">
          <Heart class="w-5 h-5 text-[#DE5D35] shrink-0" aria-hidden="true" />
          <span class="font-medium">Dikelola dan dirawat khusus untuk kenyamanan digital seluruh anggota keluarga.</span>
        </div>
      </div>

      <!-- Kolom Kanan: Daftar Alamat Web Ramah Pengguna -->
      <div id="subdomain-routes" class="lg:col-span-7 bg-white rounded-3xl border-2 border-[#161513] shadow-brutal overflow-hidden scroll-mt-20 sm:scroll-mt-24">
        
        <div class="px-6 py-4 bg-[#F2ECE1] border-b-2 border-[#161513] flex items-center justify-between gap-4">
          <div>
            <h3 class="font-serif font-black text-lg text-[#161513]">
              Daftar Alamat Web Resmi
            </h3>
            <p class="text-xs text-[#6B655D] font-mono">Bisa disimpan di penanda (bookmark) peramban Anda</p>
          </div>
          <span class="w-8 h-8 rounded-full bg-white border border-[#161513] flex items-center justify-center text-[#DE5D35] shadow-brutal-sm">
            <Sparkles class="w-4 h-4" aria-hidden="true" />
          </span>
        </div>

        <div class="divide-y-2 divide-[#161513] text-xs">
          {caddyProxyChain.map((route) => {
            const fullUrl = `https://${route.from}`;
            return (
              <div class="p-4 sm:p-5 flex items-center justify-between gap-4 hover:bg-[#FAF7F0] transition-colors">
                <div class="min-w-0">
                  <div class="font-bold text-[#161513] text-sm sm:text-base truncate">
                    {route.target}
                  </div>
                  <div class="text-xs font-mono font-bold text-[#DE5D35] mt-0.5 truncate" translate="no">
                    {route.from}
                  </div>
                </div>

                <div class="flex items-center gap-2.5 shrink-0">
                  <button
                    type="button"
                    class="copy-btn min-h-[38px] px-3.5 py-1.5 rounded-full border-2 border-[#161513] bg-white hover:bg-[#EAA838] text-[#161513] transition-[background-color,transform] cursor-pointer text-xs font-bold uppercase tracking-wider inline-flex items-center gap-1.5 shadow-brutal-sm active:translate-x-0.5 active:translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#161513]"
                    data-copy-text={route.from}
                    data-service-name={route.target}
                    aria-label={`Salin alamat ${route.from} untuk ${route.target}`}
                    title={`Salin alamat ${route.from}`}
                  >
                    <Copy class="w-3.5 h-3.5 text-[#161513]" aria-hidden="true" />
                    <span class="copy-label hidden sm:inline">Salin</span>
                  </button>
                  <a
                    href={fullUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="min-h-[38px] px-4 py-1.5 rounded-full bg-[#161513] hover:bg-[#DE5D35] text-[#FAF7F0] border-2 border-[#161513] transition-[background-color,transform] inline-flex items-center gap-1 text-xs font-bold uppercase tracking-wider shadow-brutal-sm hover:scale-105 active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#161513]"
                    title={`Buka ${fullUrl} di tab baru`}
                    aria-label={`Buka ${fullUrl} di tab baru`}
                  >
                    <span>Buka</span>
                    <ArrowUpRight class="w-3.5 h-3.5 stroke-[2.5]" aria-hidden="true" />
                  </a>
                </div>
              </div>
            );
          })}
        </div>

      </div>

    </div>

  </div>
</section>
