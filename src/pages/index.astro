---
import Layout from '../layouts/Layout.astro';
import HeroStatusCard from '../components/HeroStatusCard.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import ServiceCard from '../components/ServiceCard.astro';
import AccessGuide from '../components/AccessGuide.astro';
import { servicesData, siteConfig } from '../data/services';
import { Film, FileText, ArrowRight, Sparkles, HardDrive } from 'lucide-astro';

// Quick action services
const jellyfin = servicesData.find(s => s.id === 'jellyfin');
const stirlingPdf = servicesData.find(s => s.id === 'stirling-pdf');
const nextcloud = servicesData.find(s => s.id === 'nextcloud');
---

<Layout title={`${siteConfig.siteName} — ${siteConfig.tagline}`}>
  
  <!-- Hero Section (Ramah Keluarga & Bersih) -->
  <section class="relative pt-8 pb-14 sm:pt-14 sm:pb-20 border-b border-warm-border/80 tech-grid-pattern">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        
        <!-- Kolom Kiri: Sambutan & Akses Cepat -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs bg-warm-sand border border-warm-border text-warm-charcoal font-semibold shadow-subtle">
            <span class="w-2 h-2 rounded-full bg-warm-accent"></span>
            <span>Layanan Mandiri Keluarga • kubiko.my.id</span>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-5xl font-extrabold text-warm-charcoal tracking-tight leading-[1.15]">
            Pusat Hiburan & Utilitas <span class="text-warm-accent">Keluarga</span>.
          </h1>

          <p class="text-base sm:text-lg text-warm-muted leading-relaxed max-w-2xl font-normal">
            Satu tempat mudah untuk menonton koleksi film bersama, menyimpan cadangan foto liburan, mengolah dokumen PDF, hingga bermain game santai — gratis dan bebas iklan komersial.
          </p>

          <!-- Quick Action Buttons -->
          <div class="pt-2 flex flex-wrap items-center gap-3 sm:gap-4">
            {jellyfin && (
              <a 
                href={jellyfin.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2.5 px-6 py-3.5 rounded-xl bg-warm-accent text-warm-bg font-bold text-sm sm:text-base hover:bg-warm-accent-hover transition-all shadow-subtle hover:scale-[1.02] active:scale-95"
              >
                <Film class="w-5 h-5" />
                <span>Nonton Film & Video</span>
                <ArrowRight class="w-4 h-4 opacity-80" />
              </a>
            )}

            {nextcloud && (
              <a 
                href={nextcloud.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2.5 px-5 py-3.5 rounded-xl bg-warm-sand text-warm-charcoal border border-warm-border font-bold text-sm sm:text-base hover:bg-warm-surface hover:border-warm-border-hover transition-all shadow-subtle active:scale-95"
              >
                <HardDrive class="w-5 h-5 text-warm-accent" />
                <span>Simpan Foto & File</span>
                <ArrowRight class="w-4 h-4 text-warm-muted" />
              </a>
            )}

            {stirlingPdf && (
              <a 
                href={stirlingPdf.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-3.5 rounded-xl bg-warm-sand text-warm-charcoal border border-warm-border font-semibold text-sm hover:bg-warm-surface hover:border-warm-border-hover transition-all shadow-subtle active:scale-95"
              >
                <FileText class="w-4 h-4 text-warm-accent" />
                <span>Alat PDF</span>
                <ArrowRight class="w-4 h-4 text-warm-muted" />
              </a>
            )}
          </div>

          <!-- Poin Ramah Keluarga -->
          <div class="pt-3 flex flex-wrap items-center gap-y-2.5 gap-x-6 text-xs sm:text-sm text-warm-muted font-medium">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-status-online"></span>
              <span>100% Gratis & Bebas Iklan</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-status-online"></span>
              <span>Bisa di HP, Laptop & Smart TV</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-status-online"></span>
              <span>Akses Cepat 24 Jam</span>
            </div>
          </div>
        </div>

        <!-- Kolom Kanan: Status Layanan Ringkas -->
        <div class="lg:col-span-5">
          <HeroStatusCard />
        </div>

      </div>
    </div>
  </section>

  <!-- Service Bento Grid Section (Katalog Layanan Lebih Besar & Jelas) -->
  <section id="services" class="py-14 sm:py-20 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header & Filter Tabs -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
        <div>
          <div class="inline-flex items-center gap-1.5 text-xs uppercase tracking-wider text-warm-muted mb-2 font-semibold">
            <span class="w-2 h-2 rounded-sm bg-warm-accent"></span>
            <span>Katalog Layanan</span>
          </div>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-warm-charcoal tracking-tight">
            Pilihan Layanan untuk Keluarga
          </h2>
          <p class="text-sm sm:text-base text-warm-muted mt-2 max-w-xl">
            Pilih layanan yang ingin digunakan. Klik kartu atau tombol untuk langsung membukanya di peramban Anda.
          </p>
        </div>

        <!-- Category Filter Tabs -->
        <div>
          <CategoryFilter services={servicesData} />
        </div>
      </div>

      <!-- Bento Grid Cards Container (Ukuran Lebih Besar: 2 Kolom Responsif) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8" id="services-grid">
        {servicesData.map(service => (
          <ServiceCard service={service} />
        ))}
      </div>

    </div>
  </section>

  <!-- Panduan Akses Mudah -->
  <AccessGuide />

  <!-- About / Privacy Section -->
  <section id="about" class="py-14 sm:py-20 bg-warm-sand/30 border-t border-warm-border scroll-mt-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-5">
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs bg-warm-sand border border-warm-border text-warm-charcoal font-semibold shadow-subtle">
        <Sparkles class="w-4 h-4 text-warm-accent" />
        <span>Khusus untuk Kenyamanan Seluruh Keluarga</span>
      </div>

      <h2 class="text-2xl sm:text-4xl font-extrabold text-warm-charcoal tracking-tight">
        Sederhana, Bersih, dan Mandiri
      </h2>

      <p class="text-sm sm:text-base text-warm-muted leading-relaxed font-normal max-w-2xl mx-auto">
        Portal ini dirancang tanpa iklan, tanpa pelacak data komersial, dan dapat diakses dengan mudah di berbagai perangkat. Dibuat khusus agar seluruh anggota keluarga dapat menikmati fasilitas digital mandiri dengan aman dan nyaman.
      </p>
    </div>
  </section>

</Layout>
