---
import Layout from '../layouts/Layout.astro';
import HeroStatusCard from '../components/HeroStatusCard.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { servicesData, siteConfig } from '../data/services';
import { Film, FileText, ArrowRight, ShieldCheck, Sparkles, Server, Network, Wifi, Lock } from 'lucide-astro';

// Quick action services
const jellyfin = servicesData.find(s => s.id === 'jellyfin');
const stirlingPdf = servicesData.find(s => s.id === 'stirling-pdf');
---

<Layout title={`${siteConfig.siteName} — ${siteConfig.tagline}`}>
  
  <!-- Hero Section (2 Kolom Asimetris) -->
  <section class="relative pt-8 pb-16 sm:pt-14 sm:pb-20 border-b border-warm-border/80 tech-grid-pattern">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <!-- Kolom Kiri: Judul, Deskripsi & Quick Actions -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-warm-sand border border-warm-border text-warm-charcoal">
            <span class="w-2 h-2 rounded-full bg-warm-accent"></span>
            <span>Self-Hosted Family Cloud • kubiko.my.id</span>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-5xl font-extrabold text-warm-charcoal tracking-tight leading-[1.15]">
            Pusat Hiburan & Utilitas <span class="text-warm-accent">Keluarga</span>.
          </h1>

          <p class="text-base sm:text-lg text-warm-muted leading-relaxed max-w-2xl font-normal">
            Satu gerbang terpadu untuk mengakses layanan mandiri di rumah — mulai dari streaming film keluarga tanpa batas, alat pengolah PDF, game server, hingga pemantauan status jaringan secara real-time.
          </p>

          <!-- Quick Action Buttons -->
          <div class="pt-2 flex flex-wrap items-center gap-3 sm:gap-4">
            {jellyfin && (
              <a 
                href={jellyfin.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2.5 px-5 py-3 rounded-xl bg-warm-accent text-warm-bg font-semibold text-sm hover:bg-warm-accent-hover transition-all shadow-subtle hover:scale-[1.02] active:scale-95"
              >
                <Film class="w-4 h-4" />
                <span>Buka Jellyfin Media</span>
                <ArrowRight class="w-4 h-4 opacity-75" />
              </a>
            )}

            {stirlingPdf && (
              <a 
                href={stirlingPdf.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2.5 px-5 py-3 rounded-xl bg-warm-sand text-warm-charcoal border border-warm-border font-semibold text-sm hover:bg-warm-surface hover:border-warm-border-hover transition-all shadow-subtle active:scale-95"
              >
                <FileText class="w-4 h-4 text-warm-accent" />
                <span>Stirling PDF Tools</span>
                <ArrowRight class="w-4 h-4 text-warm-muted" />
              </a>
            )}
          </div>

          <!-- Feature Bullets (Warm Technical Style) -->
          <div class="pt-4 flex flex-wrap items-center gap-y-2 gap-x-6 text-xs font-mono text-warm-muted">
            <div class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-status-online"></span>
              <span>Zero Public Port Forward</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-status-online"></span>
              <span>Tailscale Encrypted Mesh</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-status-online"></span>
              <span>Lightweight Static Portal</span>
            </div>
          </div>
        </div>

        <!-- Kolom Kanan: Status Card ala Cloudzy -->
        <div class="lg:col-span-5">
          <HeroStatusCard />
        </div>

      </div>
    </div>
  </section>

  <!-- Service Bento Grid Section (Inti Halaman) -->
  <section id="services" class="py-14 sm:py-20 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header & Filter Tabs -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
        <div>
          <div class="inline-flex items-center gap-1.5 text-xs font-mono uppercase tracking-wider text-warm-muted mb-2">
            <span class="w-2 h-2 rounded-sm bg-warm-accent"></span>
            <span>Direktori Layanan</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-warm-charcoal tracking-tight">
            Katalog Layanan Keluarga
          </h2>
          <p class="text-sm text-warm-muted mt-1 max-w-xl">
            Klik kartu untuk membuka aplikasi di tab baru, atau gunakan tombol salin untuk alamat IP server.
          </p>
        </div>

        <!-- Category Filter Tabs -->
        <div>
          <CategoryFilter services={servicesData} />
        </div>
      </div>

      <!-- Bento Grid Cards Container -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="services-grid">
        {servicesData.map(service => (
          <ServiceCard service={service} />
        ))}
      </div>

    </div>
  </section>

  <!-- Network & Architecture Section ala Technical Documentation -->
  <section id="topology" class="py-14 sm:py-20 bg-warm-sand/40 border-y border-warm-border scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mb-10">
        <div class="inline-flex items-center gap-1.5 text-xs font-mono uppercase tracking-wider text-warm-muted mb-2">
          <span class="w-2 h-2 rounded-sm bg-warm-accent"></span>
          <span>Arsitektur Jaringan</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-warm-charcoal tracking-tight">
          Edge Reverse Proxy over Mesh VPN
        </h2>
        <p class="text-sm text-warm-muted mt-2 leading-relaxed">
          Bagaimana cara portal ini bekerja? Sistem mengombinasikan VPS publik mini dengan jaringan mesh privat Tailscale untuk menembus CGNAT ISP rumah tanpa perlu membuka port router.
        </p>
      </div>

      <!-- Architecture Visual Flow (Bento Box) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 font-mono text-xs">
        
        <!-- Step 1: User & VPS -->
        <div class="p-6 rounded-2xl bg-warm-surface border border-warm-border space-y-4">
          <div class="w-10 h-10 rounded-xl bg-warm-sand flex items-center justify-center text-warm-charcoal">
            <Server class="w-5 h-5 text-warm-accent" />
          </div>
          <div>
            <div class="text-[10px] text-warm-muted uppercase tracking-wider">Tahap 1 • Edge Layer</div>
            <h3 class="text-base font-bold text-warm-charcoal font-sans mt-0.5">VPS Publik (Singapore)</h3>
          </div>
          <p class="text-warm-muted font-sans text-xs leading-relaxed">
            Menerima permintaan HTTPS dari browser pengunjung melalui domain <code class="text-warm-charcoal font-mono bg-warm-sand px-1 py-0.5 rounded">kubiko.my.id</code>. Dikelola oleh Caddy dengan SSL otomatis Let's Encrypt.
          </p>
          <div class="pt-2 border-t border-warm-border text-[11px] text-emerald-700 bg-emerald-50/50 p-2 rounded-lg border border-emerald-100">
            ✓ Konsumsi VPS: &lt;15MB RAM (Zero runtime)
          </div>
        </div>

        <!-- Step 2: Tailscale Mesh -->
        <div class="p-6 rounded-2xl bg-warm-surface border border-warm-border space-y-4">
          <div class="w-10 h-10 rounded-xl bg-warm-sand flex items-center justify-center text-warm-charcoal">
            <Lock class="w-5 h-5 text-warm-accent" />
          </div>
          <div>
            <div class="text-[10px] text-warm-muted uppercase tracking-wider">Tahap 2 • Private Tunnel</div>
            <h3 class="text-base font-bold text-warm-charcoal font-sans mt-0.5">Tailscale Mesh VPN</h3>
          </div>
          <p class="text-warm-muted font-sans text-xs leading-relaxed">
            Koneksi terenkripsi WireGuard point-to-point antara VPS publik dan Home Server di rumah. Meneruskan paket data secara langsung tanpa perantara pihak ketiga yang mengintip.
          </p>
          <div class="pt-2 border-t border-warm-border text-[11px] text-blue-700 bg-blue-50/50 p-2 rounded-lg border border-blue-100">
            ✓ NAT Traversal: Tembus CGNAT 100%
          </div>
        </div>

        <!-- Step 3: Home Server Core -->
        <div class="p-6 rounded-2xl bg-warm-surface border border-warm-border space-y-4">
          <div class="w-10 h-10 rounded-xl bg-warm-sand flex items-center justify-center text-warm-charcoal">
            <Network class="w-5 h-5 text-warm-accent" />
          </div>
          <div>
            <div class="text-[10px] text-warm-muted uppercase tracking-wider">Tahap 3 • Local Core</div>
            <h3 class="text-base font-bold text-warm-charcoal font-sans mt-0.5">Home Server (Di Rumah)</h3>
          </div>
          <p class="text-warm-muted font-sans text-xs leading-relaxed">
            Menjalankan aplikasi sebenarnya seperti Jellyfin, Stirling PDF, Game Server, dan Uptime Kuma. Seluruh file film dan berkas sensitif tetap tersimpan secara privat di rumah.
          </p>
          <div class="pt-2 border-t border-warm-border text-[11px] text-amber-800 bg-amber-50/50 p-2 rounded-lg border border-amber-100">
            ✓ Keamanan: Router rumah 0 port terbuka
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- About / Privacy Section -->
  <section id="about" class="py-14 sm:py-20 scroll-mt-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono bg-warm-sand border border-warm-border text-warm-charcoal">
        <Sparkles class="w-3.5 h-3.5 text-warm-accent" />
        <span>Dirancang Khusus Keluarga & Privasi</span>
      </div>

      <h2 class="text-2xl sm:text-3xl font-extrabold text-warm-charcoal tracking-tight">
        Sederhana, Bersih, dan Mandiri
      </h2>

      <p class="text-sm sm:text-base text-warm-muted leading-relaxed font-normal">
        Portal ini tidak memuat iklan, analitik invasif, ataupun pelacak data pihak ketiga. Dibangun dengan pendekatan Static Site Generation (SSG) agar loading seketika dalam hitungan milidetik serta hemat bandwidth internet.
      </p>

      <div class="pt-4 flex justify-center items-center gap-4">
        <a 
          href={siteConfig.statusPageUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-warm-sand text-warm-charcoal border border-warm-border hover:border-warm-border-hover text-xs font-mono font-medium transition-colors"
        >
          <span>Buka Status Page Kuma</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>
      </div>
    </div>
  </section>

</Layout>
