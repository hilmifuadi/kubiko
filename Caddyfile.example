# ==============================================================================
# Contoh Konfigurasi Caddyfile (Reverse Proxy & Static Web Server)
# ==============================================================================

# 1. Main Portal (Static Astro SSG Build) + Heartbeat Proxy
kubiko.my.id, www.kubiko.my.id {
    encode gzip zstd

    # Meneruskan API status Uptime Kuma agar tidak terkena CORS
    handle /api/status-page/* {
        reverse_proxy {$STATUS_BACKEND:127.0.0.1:3001}
    }

    # Sajikan file statis Astro murni
    handle {
        root * /var/www/kubiko/dist
        try_files {path} {path}/ /index.html
        file_server
    }
}

# 2. Jellyfin Media Server
nonton.kubiko.my.id {
    encode gzip zstd
    reverse_proxy {$JELLYFIN_BACKEND:127.0.0.1:8096}
}

# 3. Nextcloud (Penyimpanan Berkas)
files.kubiko.my.id {
    encode gzip zstd
    reverse_proxy {$NEXTCLOUD_BACKEND:127.0.0.1:8443}
}

# 4. Stirling PDF Tools
pdf.kubiko.my.id {
    encode gzip zstd
    reverse_proxy {$PDF_BACKEND:127.0.0.1:8889}
}

# 5. Uptime Kuma Status Page
status.kubiko.my.id {
    encode gzip zstd
    reverse_proxy {$STATUS_BACKEND:127.0.0.1:3001}
}
