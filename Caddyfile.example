# ==============================================================================
# Caddyfile untuk Edge Reverse Proxy kubiko.my.id
# Letakkan konfigurasi ini di VPS Edge (/etc/caddy/Caddyfile)
# IP Tailscale Home Server: 100.96.87.92
# ==============================================================================

# 1. Main Portal (Static Astro SSG Build) + Heartbeat Proxy
kubiko.my.id, www.kubiko.my.id {
    encode gzip zstd

    # Meneruskan API status Uptime Kuma agar tidak terkena CORS
    handle /api/status-page/* {
        reverse_proxy 100.96.87.92:3001
    }

    # Sajikan file statis Astro murni
    handle {
        root * /var/www/kubiko/dist
        try_files {path} /index.html
        file_server
    }
}

# 2. Jellyfin Media Server (Streaming Film Keluarga)
nonton.kubiko.my.id {
    encode gzip zstd
    reverse_proxy 100.96.87.92:8096 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# 3. Nextcloud (Penyimpanan Cloud Pribadi & Backup Foto)
files.kubiko.my.id {
    encode gzip zstd
    request_body {
        max_size 10GB
    }
    reverse_proxy 100.96.87.92:8081 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# 4. Stirling PDF Tools (Manipulasi Berkas PDF)
pdf.kubiko.my.id {
    encode gzip zstd
    request_body {
        max_size 250MB
    }
    reverse_proxy 100.96.87.92:8080
}

# 5. Crafty Controller (Minecraft Dashboard & Game Server)
crafty.kubiko.my.id {
    encode gzip zstd
    reverse_proxy 100.96.87.92:8443 {
        # Crafty menggunakan HTTPS internal self-signed
        transport http {
            tls_insecure_skip_verify
        }
    }
}

# 6. Zona Game Keluarga (Game Web Subdomain)
game.kubiko.my.id {
    encode gzip zstd
    reverse_proxy 100.96.87.92:3002
}

# 7. Uptime Kuma Status Page (24/7 SLA Monitor)
status.kubiko.my.id {
    encode gzip zstd
    reverse_proxy 100.96.87.92:3001
}
